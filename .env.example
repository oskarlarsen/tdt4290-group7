# Copy to .env and fill in real values before running `docker compose up`.
# These are only used for local/dev stacks; use a real secrets manager in production.

# Secret used to sign JWTs. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Password for the seeded demo admin account (advisor.hansen@kommune.no)
SEED_ADMIN_PASSWORD=

# Password for the seeded demo supplier account (supplier@nordvik.no)
SEED_SUPPLIER_PASSWORD=

# Set to true to write password reset tokens to the backend log (no email delivery yet).
# Local development only: anyone who can read the logs can take over any account.
ALLOW_DEV_PASSWORD_RESET_LOG=false

# Origin(s) the backend accepts browser requests from, comma-separated (host:port, no scheme)
CORS_ALLOWED_ORIGINS=localhost:3000

# Base URL the frontend is built to call, baked in at Docker build time
VITE_API_BASE_URL=http://localhost:8080/api
