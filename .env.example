# Single configuration for local Gradle/Vite development and Docker Compose.
# Copy this file to root .env once; never commit .env or put it in an image.
# Required: fill JWT_SECRET and the admin seed password privately before starting the backend.
# Use literal, single-line values; single-quote secrets containing # or $.
# The standalone backend does not expand ${OTHER_VARIABLE} references.
# In production, inject settings using the deployment platform's secret management.

# Secret used to sign JWTs. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Password for the seeded demo admin account (advisor.hansen@kommune.no)
SEED_ADMIN_PASSWORD=

# dev or prod (default). Dev-only features refuse to start in prod.
APP_ENV=prod

# Set to true to write password reset tokens to the backend log (no email delivery yet).
# Requires APP_ENV=dev: anyone who can read the logs can take over any account.
ALLOW_DEV_PASSWORD_RESET_LOG=false

# Mark the auth cookie Secure. Keep true; set false only if your browser drops Secure cookies
# on http://localhost (Safari does, Chrome and Firefox don't).
AUTH_COOKIE_SECURE=true

# Origin(s) the backend accepts browser requests from, comma-separated full origins
# (scheme://host:port). Each allows only its own scheme; use https:// outside local dev.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Base URL the frontend is built to call, baked in at Docker build time
VITE_API_BASE_URL=http://localhost:8080/api
# Adds fictional energy records for the real contracts. Use together with scripts/seed-demo-data.mjs for a demo;
# keep false for real data.
VITE_USE_MOCKS=false

# Offline demo sign-in only. Keep false for Vehicles, which requires a real admin cookie.
# Independent of VITE_USE_MOCKS, so prototype demo data can use real sign-in.
VITE_USE_MOCK_AUTH=false

# Optional vehicle registry integration; leave blank for local-only checks.
SVV_API_KEY=
SVV_CACHE_TTL_DAYS=14

# Origin (scheme://host:port) of VITE_API_BASE_URL; allowed in the frontend's Content-Security-Policy
API_ORIGIN=http://localhost:8080

# Optional backend settings in both run modes. Defaults shown; uncomment if needed.
# JWT_ISSUER=tdt4290-backend
# JWT_AUDIENCE=tdt4290-frontend
# TRUSTED_PROXY_HOPS=0

# Optional standalone-only backend settings. Docker keeps its own listen/data paths.
# HOST=127.0.0.1
# PORT=8080
# DATABASE_PATH=data/app.db
# TESSERACT_PATH='C:/Program Files/Tesseract-OCR/tesseract.exe'
# Relative database paths use the backend working directory. Docker keeps its own
# listen address/port and /app/data volume; HOST/PORT/DATABASE_PATH above are not
# passed by Compose. TESSERACT_PATH is also standalone-only (host paths are not
# container paths). Do not copy .env into frontend or backend build contexts.
